  {
    "scheme_id": "CSS-003",
    "scheme_name": "Jal Jeevan Mission (JJM)",
    "description": "Functional Household Tap Connections (FHTC) and community taps for small hamlets (≤20 HH).",
    "target_states": [
      "Telangana",
      "Odisha",
      "Tripura",
      "Madhya Pradesh"
    ],
    "eligibility_human": "Village FHTC coverage <100% OR presence of hamlets with ≤20 HH OR groundwater_index = 'Low'.",
    "eligibility": {
      "logic": "any",
      "conditions": [
        {
          "field": "fhtc_coverage_pct",
          "op": "<",
          "value": 100
        },
        {
          "field": "hamlets_leq_20hh",
          "op": ">",
          "value": 0
        },
        {
          "field": "groundwater_index",
          "op": "==",
          "value": "Low"
        }
      ]
    },
    "benefit": "Piped water supply infrastructure and community taps."
  },
