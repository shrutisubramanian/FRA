    "description": "Pucca houses for eligible ST households (priority where households lack pucca houses).",
    "target_states": [
      "Telangana",
      "Odisha",
      "Tripura",
      "Madhya Pradesh"
    ],
    "eligibility_human": "Village has ST households with <100% pucca house coverage; priority to villages with lower pct_pucca_houses.",
    "eligibility": {
      "logic": "any",
      "conditions": [
        {
          "field": "pct_pucca_houses",
          "op": "<",
          "value": 100
        }
      ]
    },
    "benefit": "Grant for pucca house construction"
  },
