  {
    "scheme_id": "CSS-006",
    "scheme_name": "MMU (NHM)",
    "description": "Mobile Medical Units for habitations where nearest health facility is far.",
    "target_states": [
      "Telangana",
      "Odisha",
      "Tripura",
      "Madhya Pradesh"
    ],
    "eligibility_human": "Nearest health centre >10 km in plain areas OR >5 km in hilly areas.",
    "eligibility": {
      "logic": "any",
      "conditions": [
        {
          "field": "nearest_health_center_km",
          "op": ">",
          "value": 10,
          "applies_if": {
            "field": "is_hilly_area",
            "op": "==",
            "value": false
          }
        },
        {
          "field": "nearest_health_center_km",
          "op": ">",
          "value": 5,
          "applies_if": {
            "field": "is_hilly_area",
            "op": "==",
            "value": true
          }
        }
      ]
    },
